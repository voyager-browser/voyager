{
  "manifest_version": 3,
  "name": "Voyager E2E Password Filler",
  "version": "1.0.0",
  "description": "Minimal unpacked extension used to verify content script support.",
  "action": {
    "default_title": "Voyager E2E Password Filler",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
